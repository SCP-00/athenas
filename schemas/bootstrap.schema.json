{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:bootstrap",
  "title": "Bootstrap",
  "description": "Athenas Agent Bootstrap — entry point for agents",
  "type": "object",
  "required": ["id", "title", "date", "status", "purpose"],
  "properties": {
    "id": { "type": "string", "pattern": "^BOOTSTRAP-\\d{4}$" },
    "title": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["Active", "Stale", "Archived"]
    },
    "purpose": { "type": "string" }
  }
}
