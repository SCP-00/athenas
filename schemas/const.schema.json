{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:const",
  "title": "Constitution",
  "description": "Athenas Constitution document — authority Level 0",
  "type": "object",
  "required": ["id", "title", "date", "status", "version", "authority"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CONST-\\d{4}$"
    },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Approved", "Superseded", "Archived"]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authority": { "type": "string", "pattern": "^Level \\d .+" },
    "ratified_by": { "type": "string" },
    "completion": { "type": "integer", "minimum": 0, "maximum": 100 },
    "missing_sections": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string" },
    "frozen": { "type": "boolean" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "validated_by": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
