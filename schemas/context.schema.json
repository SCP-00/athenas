{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:context",
  "title": "Context",
  "description": "Athenas Current Context — daily snapshot",
  "type": "object",
  "required": ["id", "title", "date", "purpose"],
  "properties": {
    "id": { "type": "string", "pattern": "^CONTEXT-" },
    "title": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "purpose": { "type": "string" }
  }
}
