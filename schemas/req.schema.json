{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:req",
  "title": "Requirement",
  "description": "Athenas Requirement document — authority Level 2",
  "type": "object",
  "required": ["id", "title", "date", "status", "version", "authority"],
  "properties": {
    "id": { "type": "string", "pattern": "^REQ-\\d{4}$" },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Approved", "Superseded", "Archived"]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authority": { "type": "string", "pattern": "^Level \\d .+" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
