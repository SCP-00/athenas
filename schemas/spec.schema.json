{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:spec",
  "title": "Specification",
  "description": "Athenas Specification document — authority Level 3",
  "type": "object",
  "required": ["id", "title", "date", "status", "version", "authority"],
  "properties": {
    "id": { "type": "string", "pattern": "^SPEC-\\d{4}$" },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Approved", "Superseded", "Archived"]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authority": { "type": "string", "pattern": "^Level \\d .+" },
    "implements": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "validated_by": { "type": "array", "items": { "type": "string" } },
    "derived_from": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
