{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenas:bench",
  "title": "Benchmark",
  "description": "Athenas Benchmark / Evidence Package — authority Level 6",
  "type": "object",
  "required": ["id", "title", "date", "status", "version", "authority"],
  "properties": {
    "id": { "type": "string", "pattern": "^BENCH-\\d{4}$" },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["Complete", "Draft", "Review"]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authority": { "type": "string", "pattern": "^Level \\d .+" },
    "validates": { "type": "array", "items": { "type": "string" } },
    "hardware": { "type": "string" },
    "runtime": { "type": "string" },
    "model": { "type": "string" },
    "quant": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
