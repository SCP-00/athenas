---
// Athenas Dashboard — Overview Page
// Reads the compiled JSON from .knowledge/ directory
import { readFileSync } from 'fs';

let summary, graph, index, timeline, decisions;

try {
  summary = JSON.parse(readFileSync('../.knowledge/summary.json', 'utf-8'));
  graph = JSON.parse(readFileSync('../.knowledge/graph.json', 'utf-8'));
  index = JSON.parse(readFileSync('../.knowledge/index.json', 'utf-8'));
  timeline = JSON.parse(readFileSync('../.knowledge/timeline.json', 'utf-8'));
  decisions = JSON.parse(readFileSync('../.knowledge/decisions.json', 'utf-8'));
} catch (e) {
  // Compiler output not generated yet
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Athenas — Engineering Platform for Local AI</title>
  <style>
    :root {
      --bg: #0d1117;
      --surface: #161b22;
      --border: #30363d;
      --text: #c9d1d9;
      --text-muted: #8b949e;
      --accent: #58a6ff;
      --green: #3fb950;
      --yellow: #d29922;
      --red: #f85149;
      --purple: #bc8cff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    header {
      border-bottom: 1px solid var(--border);
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    header h1 { font-size: 1.5rem; color: #fff; }
    header span { color: var(--accent); font-weight: 700; }
    header .phase {
      background: var(--accent);
      color: #000;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    nav {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    nav a {
      padding: 0.75rem 1.5rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.875rem;
      border-bottom: 2px solid transparent;
      transition: all 0.2s;
    }
    nav a:hover, nav a.active {
      color: #fff;
      border-bottom-color: var(--accent);
    }
    h2 { font-size: 1.25rem; margin: 2rem 0 1rem; color: #fff; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem;
    }
    .stat-card .value { font-size: 2rem; font-weight: 700; color: #fff; }
    .stat-card .label { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
    .stat-card .accent { color: var(--accent); }
    .stat-card .green { color: var(--green); }
    .stat-card .yellow { color: var(--yellow); }
    .stat-card .purple { color: var(--purple); }
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 2rem;
    }
    th, td {
      padding: 0.75rem 1rem;
      text-align: left;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--border);
    }
    th { background: #1c2128; color: var(--text-muted); font-weight: 600; }
    td { color: var(--text); }
    .badge {
      display: inline-block;
      padding: 0.125rem 0.5rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 500;
    }
    .badge.active { background: #0d5320; color: var(--green); }
    .badge.draft { background: #3b2e00; color: var(--yellow); }
    .badge.approved { background: #002d5a; color: var(--accent); }
    .footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      padding: 2rem;
      border-top: 1px solid var(--border);
      margin-top: 3rem;
    }
    .timeline-list { list-style: none; }
    .timeline-list li {
      padding: 0.5rem 0;
      border-left: 2px solid var(--border);
      padding-left: 1rem;
      margin-left: 0.5rem;
      position: relative;
    }
    .timeline-list li::before {
      content: '';
      position: absolute;
      left: -5px;
      top: 0.75rem;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }
    .timeline-list .date { color: var(--text-muted); font-size: 0.8rem; }
    @media (max-width: 768px) {
      .container { padding: 1rem; }
      header { flex-wrap: wrap; }
      nav { overflow-x: auto; }
    }
  </style>
</head>
<body>
  <header>
    <h1><span>ATHENAS</span> Engineering Platform for Local AI</h1>
    <span class="phase">Genesis v0.1.0</span>
  </header>

  <nav>
    <a href="/athenas/" class="active">Overview</a>
    <a href="/athenas/documents">Documents</a>
    <a href="/athenas/graph">Knowledge Graph</a>
    <a href="/athenas/timeline">Timeline</a>
    <a href="https://github.com/SCP-00/athenas" target="_blank">GitHub →</a>
  </nav>

  <main class="container">
    {summary ? (
      <>
        <h2>System Status</h2>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="value accent">{summary.total_documents}</div>
            <div class="label">Documents</div>
          </div>
          <div class="stat-card">
            <div class="value green">{summary.total_relationships}</div>
            <div class="label">Relationships</div>
          </div>
          <div class="stat-card">
            <div class="value yellow">{Object.keys(summary.document_types || {}).length}</div>
            <div class="label">Document Types</div>
          </div>
          <div class="stat-card">
            <div class="value purple">{summary.errors || 0}</div>
            <div class="label">Errors</div>
          </div>
        </div>

        <h2>Document Types</h2>
        <table>
          <thead>
            <tr><th>Type</th><th>Count</th></tr>
          </thead>
          <tbody>
            {summary.document_types && Object.entries(summary.document_types).map(([type, count]) => (
              <tr><td>{type}</td><td>{count}</td></tr>
            ))}
          </tbody>
        </table>

        <h2>Recent Timeline</h2>
        <ul class="timeline-list">
          {timeline && timeline.slice(-5).reverse().map(entry => (
            <li>
              <span class="date">{entry.date}</span><br />
              <strong>{entry.id}</strong> — {entry.title}
            </li>
          ))}
        </ul>

        <h2>Recent Decisions</h2>
        <table>
          <thead>
            <tr><th>Date</th><th>Decision</th><th>Rationale</th></tr>
          </thead>
          <tbody>
            {decisions && decisions.slice(-5).reverse().map(d => (
              <tr>
                <td>{d.date}</td>
                <td><strong>{d.decision}</strong></td>
                <td>{d.rationale}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ) : (
      <p style="text-align:center; margin-top:3rem; color: var(--text-muted);">
        Run <code>athenas build</code> to generate the knowledge base.
      </p>
    )}
  </main>

  <footer class="footer">
    Athenas — Engineering Platform for Local AI · Genesis v0.1.0 · Built with Rust + Astro
  </footer>
</body>
</html>
