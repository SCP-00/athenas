---
// Athenas Dashboard — Timeline Page
import { readFileSync } from 'fs';

let timeline = [];
let decisions = [];
try {
  timeline = JSON.parse(readFileSync('../.knowledge/timeline.json', 'utf-8'));
  decisions = JSON.parse(readFileSync('../.knowledge/decisions.json', 'utf-8'));
} catch (e) {}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Timeline — Athenas</title>
  <style>
    :root {
      --bg: #0d1117; --surface: #161b22; --border: #30363d;
      --text: #c9d1d9; --text-muted: #8b949e; --accent: #58a6ff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); }
    .container { max-width: 900px; margin: 0 auto; padding: 2rem; }
    header { border-bottom: 1px solid var(--border); padding: 1.5rem 2rem; }
    header h1 { font-size: 1.5rem; color: #fff; }
    header h1 span { color: var(--accent); }
    nav { display: flex; gap: 0; border-bottom: 1px solid var(--border); background: var(--surface); }
    nav a { padding: 0.75rem 1.5rem; color: var(--text-muted); text-decoration: none; font-size: 0.875rem; border-bottom: 2px solid transparent; }
    nav a:hover, nav a.active { color: #fff; border-bottom-color: var(--accent); }
    h2 { font-size: 1.25rem; margin: 2rem 0 1rem; color: #fff; }
    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--border); }
    .item { position: relative; padding: 1rem 0; }
    .item::before { content: ''; position: absolute; left: -2rem; top: 1.25rem; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); }
    .item .date { color: var(--text-muted); font-size: 0.8rem; }
    .item .id { color: var(--accent); font-weight: 600; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
    .stat-card .value { font-size: 1.5rem; font-weight: 700; color: #fff; }
    .stat-card .label { font-size: 0.8rem; color: var(--text-muted); }
    .footer { text-align: center; color: var(--text-muted); font-size: 0.8rem; padding: 2rem; border-top: 1px solid var(--border); margin-top: 3rem; }
  </style>
</head>
<body>
  <header><h1><span>ATHENAS</span> Timeline</h1></header>
  <nav>
    <a href="/athenas/">Overview</a>
    <a href="/athenas/documents">Documents</a>
    <a href="/athenas/graph">Knowledge Graph</a>
    <a href="/athenas/timeline" class="active">Timeline</a>
    <a href="https://github.com/SCP-00/athenas" target="_blank">GitHub →</a>
  </nav>

  <main class="container">
    <div class="stats-grid">
      <div class="stat-card"><div class="value">{timeline.length}</div><div class="label">Events</div></div>
      <div class="stat-card"><div class="value">{decisions.length}</div><div class="label">Decisions</div></div>
    </div>

    <h2>Document Timeline</h2>
    <div class="timeline">
      {timeline.length > 0 ? timeline.map(entry => (
        <div class="item">
          <span class="date">{entry.date}</span><br />
          <span class="id">{entry.id}</span> — {entry.title}
        </div>
      )) : <p style="color: var(--text-muted);">No timeline events yet.</p>}
    </div>

    {decisions.length > 0 && (
      <>
        <h2 style="margin-top:3rem;">Decision Log</h2>
        <div class="timeline">
          {decisions.map(d => (
            <div class="item">
              <span class="date">{d.date}</span><br />
              <strong>{d.decision}</strong><br />
              <span style="color: var(--text-muted); font-size:0.85rem;">{d.rationale} ({d.id})</span>
            </div>
          ))}
        </div>
      </>
    )}
  </main>
  <footer class="footer">Athenas · Genesis v0.1.0</footer>
</body>
</html>
